<Window x:Class="WpfApp1.EvenimentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adăugare Eveniment Nou" Height="500" Width="450"
        Background="#F5F1E8" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="📅 DETALII EVENIMENT" FontSize="22" FontWeight="Bold" 
                       Foreground="#2F5D50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Label Content="Nume Eveniment:"/>
            <TextBox x:Name="txtNume" Height="30" Margin="0,5"/>

            <Label Content="Locație:"/>
            <TextBox x:Name="txtLocatie" Height="30" Margin="0,5"/>

            <Label Content="Data Evenimentului:"/>
            <DatePicker x:Name="dpData" Height="30" Margin="0,5"/>

            <Label Content="Tip Eveniment:"/>
            <ComboBox x:Name="cmbTip" Height="30" Margin="0,5">
                <ComboBoxItem Content="Cultural"/>
                <ComboBoxItem Content="Sportiv"/>
                <ComboBoxItem Content="Corporate"/>
                <ComboBoxItem Content="Privat"/>
            </ComboBox>

            <UniformGrid Columns="2" Margin="0,30,0,0">
                <Button Content="💾 SALVEAZĂ" Height="40" Margin="5" 
                        Background="#2F5D50" Foreground="White" Click="btnSalveaza_Click"/>
                <Button Content="❌ ANULEAZĂ" Height="40" Margin="5" 
                        Click="btnAnuleaza_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>