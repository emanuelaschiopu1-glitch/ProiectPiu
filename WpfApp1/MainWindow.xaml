<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Planner Pro - Meniu" Height="450" Width="400" 
        Background="#F5F1E8" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2F5D50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid VerticalAlignment="Center">
        <StackPanel Margin="30">
            <TextBlock Text="EVENT MANAGER" FontSize="28" FontWeight="Bold" 
               Foreground="#2F5D50" HorizontalAlignment="Center" Margin="0,0,0,40"/>

            <Button Content="📅 EVENIMENT NOU" Height="50" Margin="0,5" 
            Click="OpenEvenimente_Click" />

            <Button Content="📋 VEZI TOATE EVENIMENTELE" Height="40" Margin="0,0,0,20" 
            Background="#D1E8E2" Foreground="#2F5D50" FontWeight="Bold"
            Click="OpenLista_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="👤 PARTICIPANȚI NOI" Height="50" Margin="0,5" 
            Click="OpenParticipanti_Click"/>

            <Button Content="📋 VEZI TOȚI PARTICIPANȚII" Height="40" Margin="0,0,0,20" 
            Background="#3498DB" Foreground="White" FontWeight="Bold"
            Click="OpenListaParticipanti_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="X IEȘIRE" Height="50" Margin="0,20,0,0" 
            Background="#E74C3C" Foreground="White" Click="Exit_Click"/>
       
        </StackPanel>
    </Grid>
</Window>