<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Planner" Height="600" Width="800" Background="#F5F1E8">

    <Grid>
        <Border Background="White" CornerRadius="18" Padding="30" Width="450" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Event Planner" FontSize="28" FontWeight="SemiBold" 
                           Foreground="#2F5D50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Label x:Name="lblNume" Content="Nume Eveniment:" Foreground="#2F5D50" FontWeight="Medium"/>
                <TextBox x:Name="txtNume" Height="35" Margin="0,0,0,2" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="errNume" Text="Nume invalid (max 15 caractere)!" Foreground="Red" 
                           Visibility="Collapsed" FontSize="11" Margin="0,0,0,10"/>

                <Label x:Name="lblLocatie" Content="Locație:" Foreground="#2F5D50" FontWeight="Medium"/>
                <TextBox x:Name="txtLocatie" Height="35" Margin="0,0,0,2" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="errLocatie" Text="Locația este obligatorie!" Foreground="Red" 
                           Visibility="Collapsed" FontSize="11" Margin="0,0,0,10"/>

                <Button x:Name="btnAdauga" Content="➕ Salvează Eveniment" Height="42" Margin="0,20,0,8" 
                        Background="#2F5D50" Foreground="White" BorderThickness="0" Click="btnAdauga_Click"/>

                <Button x:Name="btnReset" Content="🔄 Resetare" Height="42" 
                        Background="#E8DFCF" Foreground="#2F5D50" BorderThickness="0" Click="btnReset_Click"/>

                <ListBox x:Name="lstEvenimente" Height="80" Margin="0,15,0,0" BorderBrush="#E8DFCF"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>