<Window x:Class="EventOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Planner"
        Height="450" Width="800"
        Background="#F5F1E8">

    <Grid>

        <Border Background="White"
                CornerRadius="18"
                Padding="35"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Event Planner"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#2F5D50"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Organizează evenimentele tale elegant"
                           FontSize="14"
                           Foreground="#6B6B6B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Button Content="➕ Adaugă eveniment"
                        Height="42"
                        Margin="0,6"
                        Background="#2F5D50"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Medium"/>

                <Button Content="📅 Lista evenimentelor"
                        Height="42"
                        Margin="0,6"
                        Background="#E8DFCF"
                        BorderThickness="0"/>

                <Button Content="Ieșire"
                        Height="42"
                        Margin="0,6"
                        Background="#EFEFEF"
                        BorderThickness="0"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>