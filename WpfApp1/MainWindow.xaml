<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Planner Manager" Height="750" Width="950" Background="#F5F1E8">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2F5D50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#2F5D50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#E8DFCF" Padding="5">
            <MenuItem Header="_Aplicație">
                <MenuItem Header="_Resetare Câmpuri" Click="btnReset_Click"/>
                <Separator />
                <MenuItem Header="_Ieșire" Click="MenuItem_Exit_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0" Grid.Row="0" Margin="10">
                <TextBlock Text="Gestiune Eveniment" FontSize="22" Foreground="#2F5D50" FontWeight="Bold" Margin="0,0,0,0"/>

                <Label x:Name="lblNume" Content="Nume Eveniment:"/>
                <TextBox x:Name="txtNume" Height="30" VerticalContentAlignment="Center"/>

                <Label x:Name="lblLocatie" Content="Locație:"/>
                <TextBox x:Name="txtLocatie" Height="30" VerticalContentAlignment="Center"/>

                <Label Content="Categorie Eveniment (ListBox):"/>
                <ListBox x:Name="lstTipuri" Height="80" Margin="0,5" SelectionMode="Single"/>

                <Label Content="Data Eveniment (DatePicker):"/>
                <DatePicker x:Name="dtpDataEveniment" Height="30" Margin="0,5"/>

                <Label Content="Tip Acces:"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <RadioButton x:Name="rbPublic" Content="Public" IsChecked="True" Margin="0,0,15,0"/>
                    <RadioButton x:Name="rbPrivat" Content="Privat"/>
                </StackPanel>

                <CheckBox x:Name="chkVIP" Content="Include zonă VIP" Margin="0,10"/>

                <Button Content="➕ Salvează Entitate" Click="btnAdauga_Click" Margin="0,10,0,5"/>
                <Button Content="🔄 Resetare Câmpuri" Background="#E8DFCF" Foreground="#2F5D50" Click="btnReset_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="10">
                <TextBlock Text="Panou Control" FontSize="22" Foreground="#2F5D50" FontWeight="Bold" Margin="0,0,0,15"/>

                <Label Content="✏️ Selectează pentru MODIFICARE (ComboBox):"/>
                <ComboBox x:Name="cmbEvenimenteModificare" Height="30" Margin="0,5" 
                      DisplayMemberPath="NumeEveniment" 
                      SelectionChanged="cmbEvenimenteModificare_SelectionChanged"/>

                <Label Content="🔍 Căutare rapidă (după nume):"/>
                <TextBox x:Name="txtCautare" Height="35" Margin="0,5" VerticalContentAlignment="Center" 
                         TextChanged="txtCautare_TextChanged" BorderBrush="#2F5D50"/>

                <Label Content="Lista entităților înregistrate:"/>
                <ListBox x:Name="lstEvenimente" Height="450" Margin="0,5" BorderBrush="#E8DFCF" BorderThickness="2"/>
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.Row="1" Margin="10" Background="#EFEBE0">
                <Separator Margin="0,10"/>
                <TextBlock Text="Adaugă Participant (Entitatea 2)" FontSize="16" Foreground="#2F5D50" FontWeight="Bold" Margin="0,5"/>

                <Label Content="Nume Participant:"/>
                <TextBox Text="{Binding ParticipantNou.Nume, UpdateSourceTrigger=PropertyChanged}" Height="25"/>

                <Label Content="Email:"/>
                <TextBox Text="{Binding ParticipantNou.Email, UpdateSourceTrigger=PropertyChanged}" Height="25"/>

                <Button Content="💾 Salvează Participant" Click="btnSalveazaParticipant_Click" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>