<Window x:Class="WpfApp1.ParticipantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Adăugare Participant" Height="450" Width="400">

    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="textBox"/>
                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="#E74C3C" FontSize="11" Margin="0,2"/>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid Background="#F5F1E8">
        <StackPanel Margin="20">
            <TextBlock Text="👤 ÎNREGISTRARE PARTICIPANT" FontSize="20" FontWeight="Bold" 
                   Foreground="#2F5D50" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <GroupBox Header="Date de contact" Padding="15" BorderBrush="#E8DFCF">
                <StackPanel>
                    <Label Content="Nume complet:"/>
                    <TextBox Height="30" Margin="0,5" VerticalContentAlignment="Center"
                         Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                         Text="{Binding ParticipantNou.Nume, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                    <Label Content="Adresa Email:"/>
                    <TextBox Height="30" Margin="0,5" VerticalContentAlignment="Center"
                         Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                         Text="{Binding ParticipantNou.Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                    <Button Content="💾 Salvează în listă" Height="40" Margin="0,20,0,0"
                        Background="#2F5D50" Foreground="White" FontWeight="Bold"
                        Click="btnSalveaza_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>