<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Planner" Height="450" Width="800" Background="#F5F1E8">

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="400">
            <TextBlock Text="Evenimente" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Name="btnAdaugaEveniment" Content="Adaugă Eveniment" Height="40" Margin="0,5"/>
            <Button Name="btnVeziEvenimente" Content="Vezi Evenimente" Height="40" Margin="0,5"/>
            <Button Name="btnAdaugaParticipant" Content="Adaugă Participant" Height="40" Margin="0,5"/>
        </StackPanel>

        <ListBox Name="lstEvenimente" Margin="0,150,0,0"/>
    </Grid>
</Window>